    {
      "id": "note",
      "type": "text",
      "x": 400,
      "y": 895,
      "strokeColor": "#868e96",
      "text": "every job gets a fresh microVM with its own kernel, deleted afterwards · microVMs cannot reach each other\nthe host is reachable only for DHCP, DNS, the Docker Hub mirror and the cache: store",
      "fontSize": 16,
      "fontFamily": 5,
      "createdAt": "2026-09-24T08:37:57.629Z",
      "updatedAt": "2026-09-24T08:37:57.629Z",
      "version": 1
    }
